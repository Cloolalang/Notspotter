    <string name="passive_mock_hint">Use manual RSRP/RSRQ during passive-only monitoring instead of live readings. Adjust sliders while running to test alert tiers.</string>
    <string name="passive_mock_rsrp">Mock RSRP</string>
    <string name="passive_mock_rsrq">Mock RSRQ</string>
    <string name="passive_mock_active_hint">Mock signal active — RSRP and RSRQ come from your manual settings, not the radio. Drag the mock sliders to test tiers and audio.</string>
    <string name="passive_signal_settings_reset">Reset to defaults</string>
    <string name="passive_signal_rsrp_section">RSRP tiers</string>
    <string name="passive_signal_g2_section">2G fallback tiers</string>
    <string name="passive_signal_g2_section_hint">Used instead of tiers 1–6 when 2G fallback is enabled and the phone is on 2G. Split at %1$d dBm: tier 7 at or above, tier 8 below.</string>
    <string name="passive_signal_g2_tier7_threshold">2G only — RX level at or above %1$d dBm</string>
    <string name="passive_signal_g2_tier8_threshold">2G only — RX level below %1$d dBm</string>
    <string name="passive_signal_deadzone_section">Dead zone tier</string>
    <string name="passive_signal_deadzone_section_hint">Used when there is no signal from any network or technology (out of service everywhere, no limited service). Tier 9 clicks replace the continuous flatline tone when enabled.</string>
    <string name="passive_signal_tier_pulse_duration">Tier %1$d signal pulse duration</string>
    <string name="passive_signal_tier_pulse_duration_hint">Click interval cannot be shorter than this duration plus 25 ms.</string>
    <string name="passive_signal_deadzone_tier_threshold">Complete dead zone — no signal on any technology</string>
    <string name="passive_signal_rsrp_section_hint">Signal range is fixed from %1$d to %2$d dBm. Drag each boundary to divide the tiers.</string>
    <string name="passive_signal_rsrq_section">RSRQ</string>
    <string name="passive_signal_rsrq_section_hint">Fair boundary range is %1$d to %2$d dB. One boundary splits poor/critical from fair.</string>
    <string name="passive_signal_boundary_no_signal">No signal at or below</string>
    <string name="passive_signal_boundary_tier_above">Tier %1$d above</string>
    <string name="passive_signal_very_strong_hint">Tier 1 tone frequency is 125% of your signal pulse setting in Alert sound settings.</string>
    <string name="passive_signal_boundary_rsrq_fair">RSRQ fair at or above</string>
    <string name="passive_signal_rsrq_single_band_hint">Tier 6 RSRQ: %1$d to %2$d dB · Tier 4+ RSRQ: %3$d to %4$d dB</string>
    <string name="passive_signal_noisy_rsrq_clicks">Noisy RSRQ passive clicks</string>
    <string name="passive_signal_noisy_rsrq_clicks_hint">During passive-only monitoring, mix white noise into signal-pulse tier clicks when RSRQ is below %1$d dB so poor signal quality is easier to hear — including on very strong RSRP. Click rate then follows RSRP only — RSRQ no longer speeds up the clicks.</string>
