    <string name="passive_signal_no_signal_section">No signal</string>
    <string name="passive_signal_rsrp_order_hint">Tiers run from strongest (Tier 1) at the top to weakest (Tier 6) below. Each tier has a click interval; Tiers 1–5 also have an RSRP boundary.</string>
    <string name="passive_signal_tier_click_value">%1$d ms</string>
    <string name="passive_signal_tier_click_effective">Plays every %1$d ms (raised to fit signal pulse duration)</string>
    <string name="passive_signal_tier_click_ping_mode">With ping monitoring: %1$d ms</string>
    <string name="passive_signal_tier_click_measurement_warning">Interval is more than twice your %1$d s measurement cycle — signal tier may change before the next click.</string>
    <string name="passive_signal_tier_click_interval">Tier %1$d click interval</string>
    <string name="passive_signal_tier_sound_enabled">Tier %1$d signal pulse sound</string>
