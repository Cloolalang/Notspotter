    <string name="notification_passive_idle">Passive idle — checking signal KPIs</string>
    <string name="passive_idle_hint">Active ping tests stopped after 10 minutes. RSRP, EARFCN, and PCI continue updating. Tap Stop to end monitoring.</string>
    <string name="passive_only_active_hint">Signal-only monitoring — no ping tests. Low-signal click rates follow your passive signal range settings. After 10 minutes, audio stops and KPI polling continues until you tap Stop.</string>
    <string name="passive_only_idle_hint">Passive-only monitoring — alert audio stopped after 10 minutes. RSRP, EARFCN, and PCI continue updating. Tap Stop to end monitoring.</string>
    <string name="notification_passive_only">Signal monitoring — no pings</string>
    <string name="passive_signal_settings_title">Passive signal ranges</string>
    <string name="passive_signal_settings_summary">Tap to set RSRP and RSRQ tier boundaries for passive monitoring alerts, reception LED, and no-signal detection.</string>
    <string name="passive_measurement_interval_label">Measurement cycle</string>
