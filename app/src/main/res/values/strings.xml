    <string name="passive_idle_hint">Active ping tests stopped after 10 minutes. Signal alert sounds and KPI polling continue until you tap Stop.</string>
    <string name="passive_only_active_hint">Signal-only monitoring — no ping tests. Low-signal click rates follow your passive signal range settings. Alert audio continues until you tap Stop.</string>
    <string name="passive_only_idle_hint">Passive-only monitoring — RSRP, EARFCN, and PCI continue updating. Tap Stop to end monitoring.</string>
    <string name="notification_passive_only">Signal monitoring — no pings</string>
    <string name="passive_signal_settings_title">Passive signal thresholds and signal pulse settings</string>
    <string name="passive_signal_settings_summary">Tap to set RSRP and RSRQ tier boundaries for passive monitoring alerts and no-signal detection.</string>
